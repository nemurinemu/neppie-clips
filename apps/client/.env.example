# Base path for the API. In prod nginx serves it same-origin, so leave as /api.
VITE_API_BASE="/api"

# Base path for nginx-served thumbnails (thumbnails/ lives under here). Kept
# same-origin so the CDN caches them; only videos move off the CDN.
VITE_MEDIA_BASE="/media"

# Videos only: served from a separate origin (direct from the VPS, bypassing the
# CDN so large video traffic doesn't proxy through it), e.g.
# https://media.example.com. Empty/unset = serve videos from VITE_MEDIA_BASE.
VITE_VIDEO_BASE=

# Dev only: proxy /api and /media to this origin (the API serves both in dev).
# Include the scheme, e.g. http://localhost:3200
VITE_DEV_PROXY_TARGET=
