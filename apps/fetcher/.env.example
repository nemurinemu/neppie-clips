# get id and hash at my.telegram.org, then run create-session.ts with empty session to log in and get TG_SESSION
API_ID=
API_HASH=
TG_SESSION=

YOUTUBE_API_KEY=
# channel handle (without @) whose streams twitch clips get matched to
YOUTUBE_CHANNEL=
# yt-dlp binary for audio alignment (default: yt-dlp on PATH)
YT_DLP=

# In dev use ../../clips, in prod use something like /var/lib/neppie-clips/
CLIPS_DIR="../../clips"

# telegram channel with the clips
TELEGRAM_CHANNEL=

# dev only: don't download the whole channel on start, just listen for new messages
SKIP_BACKFILL=

# Twitch app (dev.twitch.tv/console/apps, Confidential client). Then run
# `pnpm twitch-login` once as the clip creator to get twitch-token.json.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# channel whose clips to pull (login name)
TWITCH_BROADCASTER=
# clips created before this date are never ours (guards against creator_id
# being rewritten when an old clip is edited)
TWITCH_CLIPS_SINCE=2026-02-01
